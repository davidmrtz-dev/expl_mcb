# Ollama API (local)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_CHAT_MODEL=qwen2.5-coder:7b

# SQLite DB path
EMCB_DB_PATH=./data/index.db

# Ask / server — defaults tuned for speed on local 7B models
EMCB_PORT=3040
EMCB_TOP_K=4
EMCB_MAX_CONTEXT_CHARS=6000
EMCB_MAX_SNIPPET_CHARS=1800
EMCB_CHAT_MAX_TOKENS=768
EMCB_CHAT_NUM_CTX=4096
EMCB_CHAT_TEMPERATURE=0.2
